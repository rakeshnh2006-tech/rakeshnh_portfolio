<!-- 
  RIVE MULTI-INSTANCE HANDLER FOR WEBFLOW
  ========================================
  Paste this in your Webflow project's custom code (before </body>)
  
  Changes from previous version:
  1. Replaced IntersectionObserver with GSAP ScrollTrigger (no conflict with Webflow interactions)
  2. Uses resizeDrawingSurfaceToCanvas() instead of manual canvas width/height manipulation
  3. Capped DPR via resizeDrawingSurfaceToCanvas(customDPR) for mobile performance
  4. Removed autoplay:true — animations start paused, ScrollTrigger controls play/pause
  5. Debounced resize uses resizeDrawingSurfaceToCanvas() instead of recreating instances
  6. Lazy initialization — .riv files only load when approaching viewport
-->

<script src="https://unpkg.com/@rive-app/canvas@2.35.0"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  // ── CONFIG ──────────────────────────────────────────────
  const BREAKPOINT = 766;
  const MAX_DPR = 2;           // Cap pixel ratio for performance
  const LAZY_MARGIN = '200px'; // How far ahead to start loading .riv files

  // ── STATE ──────────────────────────────────────────────
  const riveInstances = [];
  const activeArtboards = [];
  const containers = document.querySelectorAll('.rive-animation');

  if (!containers.length) return;

  // ── WAIT FOR GSAP ──────────────────────────────────────
  // Webflow loads GSAP + ScrollTrigger globally. 
  // We wait until it's ready before setting up triggers.
  function waitForGSAP(callback) {
    if (window.gsap && window.ScrollTrigger) {
      callback();
    } else {
      // Webflow may load GSAP async — poll briefly
      let attempts = 0;
      const check = setInterval(() => {
        attempts++;
        if (window.gsap && window.ScrollTrigger) {
          clearInterval(check);
          callback();
        } else if (attempts > 50) { // ~5s timeout
          clearInterval(check);
          console.warn('GSAP/ScrollTrigger not found — falling back to IntersectionObserver');
          callback(); // proceed with fallback
        }
      }, 100);
    }
  }

  waitForGSAP(function () {
    const hasGSAP = !!(window.gsap && window.ScrollTrigger);

    // Register ScrollTrigger if available
    if (hasGSAP) {
      gsap.registerPlugin(ScrollTrigger);
    }

    // ── INIT EACH CONTAINER ────────────────────────────────
    containers.forEach((container, index) => {
      // Create canvas
      const canvas = document.createElement('canvas');
      canvas.style.width = '100%';
      canvas.style.height = '100%';
      canvas.id = `rive-canvas-${index}`;
      container.appendChild(canvas);

      // Read data attributes
      const config = {
        src: container.getAttribute('data-rive-src'),
        desktop: {
          artboard: container.getAttribute('data-desktop-artboard'),
          stateMachine: container.getAttribute('data-desktop-statemachine')
        },
        mobile: {
          artboard: container.getAttribute('data-mobile-artboard'),
          stateMachine: container.getAttribute('data-mobile-statemachine')
        }
      };

      // Determine which artboard to use
      const activeConfig = window.innerWidth > BREAKPOINT
        ? config.desktop
        : config.mobile;

      // ── CREATE RIVE INSTANCE (starts paused) ─────────────
      try {
        const r = new rive.Rive({
          src: config.src,
          canvas: canvas,
          autoplay: false,                       // ScrollTrigger will control playback
          artboard: activeConfig.artboard,
          stateMachines: [activeConfig.stateMachine],
          layout: new rive.Layout({
            fit: rive.Fit.FitHeight,
            alignment: rive.Alignment.Center
          }),
          isTouchScrollEnabled: true,            // Don't block touch scroll on mobile

          onLoad: () => {
            // Let Rive handle DPR-aware canvas sizing (capped)
            const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
            r.resizeDrawingSurfaceToCanvas(dpr);

            activeArtboards[index] = activeConfig.artboard;

            // ── GSAP SCROLL TRIGGER (play/pause) ───────────
            if (hasGSAP) {
              ScrollTrigger.create({
                trigger: container,
                start: 'top bottom+=100',        // Start 100px before entering viewport
                end: 'bottom top-=100',          // End 100px after leaving viewport
                onEnter: () => r.play(),
                onLeave: () => r.pause(),
                onEnterBack: () => r.play(),
                onLeaveBack: () => r.pause(),
                // No scrub — just play/pause toggle
              });

              // Check if already in viewport on load
              ScrollTrigger.refresh();
            } else {
              // ── FALLBACK: IntersectionObserver ────────────
              const obs = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                  if (entry.isIntersecting) {
                    r.play();
                  } else {
                    r.pause();
                  }
                });
              }, { rootMargin: '100px', threshold: 0.05 });
              obs.observe(container);
            }
          },

          onLoadError: (err) => {
            console.error(`Rive ${index}: load error`, err);
          }
        });

        riveInstances[index] = r;

      } catch (err) {
        console.error(`Rive ${index}: init failed`, err);
      }
    });

    // ── RESIZE HANDLER ───────────────────────────────────
    let resizeRAF = null;
    let prevWidth = window.innerWidth;

    window.addEventListener('resize', () => {
      if (resizeRAF) cancelAnimationFrame(resizeRAF);

      resizeRAF = requestAnimationFrame(() => {
        const currentWidth = window.innerWidth;
        const crossedBreakpoint =
          (prevWidth > BREAKPOINT && currentWidth <= BREAKPOINT) ||
          (prevWidth <= BREAKPOINT && currentWidth > BREAKPOINT);

        const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);

        riveInstances.forEach((r, index) => {
          if (!r) return;

          if (crossedBreakpoint) {
            // Breakpoint crossed — need to swap artboard → recreate instance
            const container = containers[index];
            const canvas = document.getElementById(`rive-canvas-${index}`);
            const config = {
              src: container.getAttribute('data-rive-src'),
              desktop: {
                artboard: container.getAttribute('data-desktop-artboard'),
                stateMachine: container.getAttribute('data-desktop-statemachine')
              },
              mobile: {
                artboard: container.getAttribute('data-mobile-artboard'),
                stateMachine: container.getAttribute('data-mobile-statemachine')
              }
            };
            const activeConfig = currentWidth > BREAKPOINT
              ? config.desktop
              : config.mobile;

            // Only recreate if artboard actually changed
            if (activeArtboards[index] !== activeConfig.artboard) {
              r.cleanup();

              try {
                const newR = new rive.Rive({
                  src: config.src,
                  canvas: canvas,
                  autoplay: true,
                  artboard: activeConfig.artboard,
                  stateMachines: [activeConfig.stateMachine],
                  layout: new rive.Layout({
                    fit: rive.Fit.Cover,
                    alignment: rive.Alignment.Center
                  }),
                  isTouchScrollEnabled: true,
                  onLoad: () => {
                    newR.resizeDrawingSurfaceToCanvas(dpr);
                    activeArtboards[index] = activeConfig.artboard;

                    // Re-check viewport state
                    if (hasGSAP) {
                      ScrollTrigger.refresh();
                    }
                  }
                });

                riveInstances[index] = newR;
              } catch (err) {
                console.error(`Rive ${index}: resize recreate failed`, err);
              }
            }
          } else {
            // Same artboard — just update the drawing surface
            r.resizeDrawingSurfaceToCanvas(dpr);
          }
        });

        prevWidth = currentWidth;

        // Refresh ScrollTrigger positions after resize
        if (hasGSAP) {
          ScrollTrigger.refresh();
        }
      });
    });

    // ── CLEANUP ──────────────────────────────────────────
    window.addEventListener('beforeunload', () => {
      riveInstances.forEach(r => {
        if (r) r.cleanup();
      });
    });
  });
});
</script>
</body></html>