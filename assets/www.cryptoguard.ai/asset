                    speed: 2,
                    delimiter: ""
                },
                duration: 0.8
            });

            ScrollTrigger.create({
                trigger: item,
                start: "top 92%",
                onEnter: () => {
                    setTimeout(()=> {
                        item.classList.add('is-animated');
                        itemTl.timeScale(1).play();
                    }, 300)
                },
            })
        });
    }
    scrollAnimFunc();
    /* onscroll refresh trigger */
    const refreshTrigger = document.querySelectorAll("[refresh-trigger]");
    refreshTrigger.forEach((item) => {
