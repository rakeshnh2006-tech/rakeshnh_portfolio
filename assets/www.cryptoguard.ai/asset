  /* scrumble text on scroll */
  document.addEventListener("DOMContentLoaded", () => {
    if (!isSafari) {
    if (Webflow.env("editor") === undefined) {
      const lenis = new Lenis();

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      function connectToScrollTrigger() {
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.lagSmoothing(0)
      }
      // Uncomment this if using GSAP ScrollTrigger
  		connectToScrollTrigger();
    }
  }
  
  /* scrumble text hero */
  const AnimTriggerHero = document.querySelectorAll("[anim-trigger-hero]");
  
    AnimTriggerHero.forEach((item) => {
        let itemTl = gsap.timeline({
            paused: true
        });
        itemTl.to(item, {
            scrambleText: {
                chars: "021zrotxinsmopsweknm",
                text: "{original}",
                speed: 2,
                delimiter: ""
            },
            duration: 0.8
        });
        document.addEventListener("DOMContentLoaded", () => {
            setTimeout(()=> {
                itemTl.timeScale(1).play();
                
                setTimeout(()=> {
                    /*itemTl.timeScale(1.5).reverse();*/
                    itemTl.classList.add('is-animated');
                }, 600)
            }, 600)

        });
    });
    
  function scrollAnimFunc() {
        const animTriggers = document.querySelectorAll("[anim-trigger]");
        animTriggers.forEach((item) => {
            let itemTl = gsap.timeline({
                paused: true
            });
            itemTl.to(item, {
                scrambleText: {
                    chars: "061kzeorqsputf",
