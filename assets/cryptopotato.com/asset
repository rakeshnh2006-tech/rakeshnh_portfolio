		CP_OUTRO_URL : "https://cryptopotato.com/wp-content/uploads/2026/05/outrotr.mp3"


    }
};

const t = translations[ siteLang ] || translations.en;
let turnstileWidgetId;
let tokenResolver = null;
let turnstileErrorState = false;
window.cpAudioSystemError = false; // NEW: Global kill switch for infinite buffering

// === GA4 TRACKING HELPER ===
function trackCPEvent(eventName, extraParams = {}) {
    try {
        const payload = Object.assign({
            'article_title': document.title,
            'page_location': window.location.href
        }, extraParams);

        if (typeof gtag === 'function') {
            gtag('event', eventName, payload);
        } else if (typeof dataLayer !== 'undefined') {
            payload.event = eventName;
            dataLayer.push(payload);
        }
    } catch (e) { }
}

window.onloadTurnstileCallback = function () {
    if (turnstileWidgetId !== undefined) return;
    turnstileWidgetId = turnstile.render('#cf-turnstile-container', {
        sitekey: '0x4AAAAAADGTpG_qAnJ-UC5z',
        size: 'invisible',
		execution: 'execute',
        refreshExpired: 'never',
        callback: function(token) {
            if (tokenResolver) {
                tokenResolver(token);
                tokenResolver = null;
            }
        },
        'error-callback': function() {
            turnstileErrorState = true;
            if (tokenResolver) {
                tokenResolver('BLOCKED_BY_BROWSER');
                tokenResolver = null;
            }
        }
    });
};

document.addEventListener('DOMContentLoaded', () => {
    const listenButtons = document.querySelectorAll('#mobilePlayBtn, #desktopPlayBtn');
    const trinityContainer = document.querySelector('.post-trinity-audio');
    const buttonContainerRow = document.querySelector('.trinity-and-ai-summary');
    const contentArea = document.querySelector('.post-details-content');
    const articleTitle = document.querySelector('h1');
    const summaryButton = document.querySelector('.trinity-and-ai-summary a, .ai-summary-btn');

    let isAudioSystemActive = false;
    let audioQueue = [];
    let currentPlayingIndex = 0;
    let totalChunks = 1;

    let tracked25 = false;
    let tracked50 = false;
    let tracked75 = false;

    if (typeof turnstile !== 'undefined' && turnstileWidgetId === undefined) {
        window.onloadTurnstileCallback();
    }

    if (summaryButton) {
        summaryButton.addEventListener('click', () => {
            trackCPEvent('ai_summary_requested');
        });
    }

    function updateOriginalButtons(text, isClickable = false) {
        listenButtons.forEach(btn => {
            const span = btn.querySelector('span');
            if (span) span.innerText = text;
            btn.style.pointerEvents = isClickable ? 'auto' : 'none';
            btn.style.opacity = isClickable ? '1' : '0.6';
        });
    }

    if (listenButtons.length > 0 && contentArea && trinityContainer) {
        listenButtons.forEach(button => {
            button.addEventListener('click', async (e) => {
                e.preventDefault();
                if (isAudioSystemActive) return;

                if (turnstileWidgetId === undefined) {
                    alert(t.security_loading);
                    return;
                }

                if (turnstileErrorState) {
                    alert(t.privacy_blocked);
                    return;
                }

                isAudioSystemActive = true;
                window.cpAudioSystemError = false; // Reset error state on new play

                trackCPEvent('ai_audio_requested');

                const playerWrapper = document.createElement('div');
                playerWrapper.id = 'cp-audio-master';

                playerWrapper.innerHTML = `
                    <div id="cp-unified-player" style="display: flex !important; align-items: center !important; gap: 12px !important; background: var(--cp__author-bg) !important; padding: 8px 18px !important; border-radius: 8px 10px 10px 8px !important; border: 1px solid var(--cp_border) !important; box-shadow: 0 4px 15px rgba(0,0,0,0.05) !important; box-sizing: border-box !important; width: 100% !important;">

                        <button id="cp-up-playpause" style="all: unset !important; appearance: none !important; background: #fed319 !important; border-radius: 50% !important; width: 36px !important; height: 36px !important; min-width: 36px !important; min-height: 36px !important; cursor: pointer !important; padding: 0 !important; margin: 0 !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; box-sizing: border-box !important;">
                            <svg id="cp-up-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" style="display: none !important; margin: 0 !important; padding: 0 !important; transform-origin: 50% 50% !important; animation: cp-spin-center 1s linear infinite !important;"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
                            <svg id="cp-up-play" width="14" height="14" viewBox="0 0 24 24" fill="#000" style="display: none; margin: 0 0 0 2px !important; padding: 0 !important;"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            <svg id="cp-up-pause" width="14" height="14" viewBox="0 0 24 24" fill="#000" style="display: block !important; margin: 0 !important; padding: 0 !important;"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
                        </button>

                        <div id="cp-up-progress-track" style="flex-grow: 1 !important; height: 8px !important; background: var(--cp_gray) !important; border-radius: 4px !important; position: relative !important; cursor: pointer !important; overflow: hidden !important; margin: 0 !important;">
                            <div id="cp-up-progress-bar" style="width: 0%; height: 100% !important; background: #fed319 !important; border-radius: 4px !important; transition: width 0.1s linear !important; pointer-events: none !important;"></div>
                        </div>

                        <span id="cp-up-status" style="color: var(--cp_primary) !important; font-size: 13px !important; font-weight: 600 !important; font-family: inherit !important; min-width: 60px !important; text-align: right !important; margin: 0 !important; line-height: 1 !important;">${t.playing}</span>
                    </div>

                    <audio id="cp-native-audio" style="display: none !important;"></audio>

                    <style>
					#cp-unified-player { position: relative; }
#cp-unified-player::after{
								    content: "";
						position: absolute;
						top: 0;
						left: 0;
						bottom: 0;
						right: auto;
						width: 4px;
						background: #f5c800;
						border-radius: 5px 0 0 5px;
						z-index: 0;}
                        #cp-audio-master { display: flex !important; width: 50% !important; }
                        @media (min-width: 768px) {
                            #cp-audio-master { justify-content: flex-end !important; }
                            #cp-unified-player { width: 320px !important; max-width: 100% !important; margin: 0 !important; }
                        }
                        @media (max-width: 767px) {
						 #cp-audio-master {width: 100% !important; }
                            #cp-audio-master { justify-content: center !important; margin-top: 15px !important; clear: both !important; }
                            #cp-unified-player { width: 100% !important; max-width: 100% !important; }
                        }
                        @keyframes cp-spin-center {
                            0% { transform: rotate(0deg); }
                            100% { transform: rotate(360deg); }
                        }
                        body.dark #cp-unified-player { background: #1a1a1a !important; border: 1px solid #333 !important; }
                        body.dark #cp-up-status { color: #aaa !important; }
                        body.dark #cp-up-progress-track { background: #333 !important; }
                    </style>
                `;

                if (window.innerWidth < 768) {
                    trinityContainer.style.display = 'none';
                    if (buttonContainerRow) {
                        buttonContainerRow.insertAdjacentElement('afterend', playerWrapper);
                    } else {
                        trinityContainer.parentNode.insertBefore(playerWrapper, trinityContainer.nextSibling);
                    }
                } else {
                    trinityContainer.parentNode.replaceChild(playerWrapper, trinityContainer);
                }

                const audioEl = document.getElementById('cp-native-audio');
                const btnPlayPause = document.getElementById('cp-up-playpause');
                const iconSpinner = document.getElementById('cp-up-spinner');
                const iconPlay = document.getElementById('cp-up-play');
                const iconPause = document.getElementById('cp-up-pause');
                const progressTrack = document.getElementById('cp-up-progress-track');
                const progressBar = document.getElementById('cp-up-progress-bar');
                const statusText = document.getElementById('cp-up-status');

                audioQueue[0] = t.CP_INTRO_URL;
                audioEl.src = audioQueue[0];

                audioEl.play().then(() => {
                    trackCPEvent('ai_audio_started');
                }).catch(e => console.log("Intro autoplay blocked:", e));

                updateOriginalButtons(t.playing_dots);

                // BUG 1 FIX: Include Blockquotes, but ignore social media embeds
                const titleText = articleTitle ? articleTitle.innerText + ". " : "";
                let cleanText = titleText;

                Array.from(contentArea.children).forEach(child => {
                    if (['P', 'H2', 'H3', 'H4', 'H5', 'H6', 'UL', 'OL', 'BLOCKQUOTE'].includes(child.tagName)) {
                        // Skip Twitter/Instagram embeds so it doesn't read garbage code
                        if (child.classList.contains('twitter-tweet') || child.classList.contains('instagram-media')) {
                            return;
                        }
                        cleanText += child.innerText + " ";
                    }
                });
                cleanText = cleanText.replace(/\s+/g, ' ').trim();

                const sentences = cleanText.match(/[^.!?]+[.!?]+/g) || [cleanText];
                let chunks = [];
                let currentChunk = "";
                let i = 0;

                while (i < sentences.length && currentChunk.length < 250) {
                    currentChunk += sentences[i] + " ";
                    i++;
                }
                if (currentChunk.trim()) {
                    chunks.push(currentChunk.trim());
                    currentChunk = "";
                }

                for (; i < sentences.length; i++) {
                    let sentence = sentences[i];
                    if ((currentChunk.length + sentence.length) < 1000) {
                        currentChunk += sentence + " ";
                    } else {
                        chunks.push(currentChunk.trim());
                        currentChunk = sentence + " ";
                    }
                }
                if (currentChunk.trim()) chunks.push(currentChunk.trim());

                totalChunks = chunks.length + 2;

                audioEl.addEventListener('timeupdate', () => {
                    if (isNaN(audioEl.duration) || totalChunks === 0) return;
                    const chunkWeight = 100 / totalChunks;
                    const baseProgress = currentPlayingIndex * chunkWeight;
                    const currentChunkProgress = (audioEl.currentTime / audioEl.duration) * chunkWeight;

                    const totalProgressPercent = baseProgress + currentChunkProgress;
                    progressBar.style.width = totalProgressPercent + '%';

                    if (totalProgressPercent >= 25 && !tracked25) {
                        tracked25 = true; trackCPEvent('ai_audio_progress', { progress_milestone: '25%' });
                    }
                    if (totalProgressPercent >= 50 && !tracked50) {
                        tracked50 = true; trackCPEvent('ai_audio_progress', { progress_milestone: '50%' });
                    }
                    if (totalProgressPercent >= 75 && !tracked75) {
                        tracked75 = true; trackCPEvent('ai_audio_progress', { progress_milestone: '75%' });
                    }
                });

                audioEl.addEventListener('ended', () => {
                    currentPlayingIndex++;
                    if (audioQueue[currentPlayingIndex]) {
                        audioEl.src = audioQueue[currentPlayingIndex];
                        audioEl.play().catch(e => console.log(e));
                    } else if (currentPlayingIndex < totalChunks) {
                        iconPause.style.display = 'none';
                        iconSpinner.style.display = 'block';
                        statusText.innerText = t.buffer;

                        // BUG 2 FIX: Monitor for total fetcher failure to prevent infinite buffer
                        let waitInterval = setInterval(() => {
                            if (audioQueue[currentPlayingIndex]) {
                                clearInterval(waitInterval);
                                iconSpinner.style.display = 'none';
                                iconPause.style.display = 'block';
                                statusText.innerText = t.playing;
                                audioEl.src = audioQueue[currentPlayingIndex];
                                audioEl.play().catch(e => console.log(e));
                            } else if (window.cpAudioSystemError) {
                                // Kill switch activated: The fetcher completely died.
                                clearInterval(waitInterval);
                                iconSpinner.style.display = 'none';
                                iconPlay.style.display = 'block';
                                statusText.innerText = t.error;
                                updateOriginalButtons( t.error, true);
                                isAudioSystemActive = false;
                            }
                        }, 500);
                    } else {
                        progressBar.style.width = '100%';
                        iconPause.style.display = 'none';
                        iconPlay.style.display = 'block';
                        statusText.innerText = t.finish;
                        updateOriginalButtons(t.listen_again, true);

                        trackCPEvent('ai_audio_completed');
                        currentPlayingIndex = 0;
                        tracked25 = false; tracked50 = false; tracked75 = false;
                    }
                });

                btnPlayPause.addEventListener('click', () => {
                    if (iconSpinner.style.display === 'block') return;

                    if (audioEl.paused) {
                        if (statusText.innerText === "Finish") audioEl.src = audioQueue[0];
                        audioEl.play();
                        iconPlay.style.display = 'none';
                        iconPause.style.display = 'block';
                        statusText.innerText = t.playing;
                        updateOriginalButtons(t.playing_dots);
                    } else {
                        audioEl.pause();
                        iconPause.style.display = 'none';
                        iconPlay.style.display = 'block';
                        statusText.innerText = t.paused;
                        updateOriginalButtons(t.paused);
                    }
                });

                progressTrack.addEventListener('click', (e) => {
                    if (totalChunks === 0 || audioQueue.length === 0) return;

                    const rect = progressTrack.getBoundingClientRect();
                    const clickX = Math.max(0, Math.min(e.clientX - rect.left, rect.width));
                    const percentage = clickX / rect.width;

                    const targetIndex = Math.floor(percentage * totalChunks);
                    const targetSafeIndex = Math.min(targetIndex, totalChunks - 1);
                    const chunkFraction = (percentage * totalChunks) - targetSafeIndex;

                    if (audioQueue[targetSafeIndex]) {
                        if (currentPlayingIndex !== targetSafeIndex) {
                            currentPlayingIndex = targetSafeIndex;
                            audioEl.src = audioQueue[targetSafeIndex];

                            const seekHandler = () => {
                                audioEl.currentTime = chunkFraction * audioEl.duration;
                                audioEl.play().catch(e => console.log(e));
                                audioEl.removeEventListener('loadedmetadata', seekHandler);

                                iconPlay.style.display = 'none';
                                iconPause.style.display = 'block';
                                statusText.innerText = t.playing;
                                updateOriginalButtons(t.playing_dots);
                            };
                            audioEl.addEventListener('loadedmetadata', seekHandler);
                        } else {
                            audioEl.currentTime = chunkFraction * audioEl.duration;
                            if (audioEl.paused && statusText.innerText !== "Finish") {
                                audioEl.play();
                                iconPlay.style.display = 'none';
                                iconPause.style.display = 'block';
                                statusText.innerText = t.playing;
                                updateOriginalButtons(t.playing_dots);
                            }
                        }
                    } else {
                        statusText.innerText = t.buffer;
                        setTimeout(() => { if(!audioEl.paused) statusText.innerText = t.playing; }, 1500);
                    }
                });

                async function processQueueSequentially() {
                    for (let i = 0; i < chunks.length; i++) {
                        let chunkBlob = null;

                        // BUG 2 FIX: 3-Attempt Auto-Retry System
                        for (let attempt = 1; attempt <= 3; attempt++) {
                            try {
                                try {
                                    if (turnstileWidgetId !== undefined) turnstile.reset(turnstileWidgetId);
                                } catch (resetErr) { }

								const token = await Promise.race([
									new Promise((resolve) => {
										tokenResolver = resolve;
										turnstile.execute(turnstileWidgetId);
									}),
									new Promise((_, reject) => setTimeout(() => reject(new Error("Turnstile Timeout")), 15000))
								]);

								if (token === 'BLOCKED_BY_BROWSER' || !token) {
									window.cpAudioSystemError = true; // Instantly activate the global kill switch
									throw new Error("Security Blocked: VPN or Privacy Settings");
								}

                                // Create a 12-second fuse
								const controller = new AbortController();
								const fetchTimeout = setTimeout(() => controller.abort(), 18000);

								const response = await fetch('https://cpaudio.cpotato.workers.dev', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({ text: chunks[i], cfToken: token }),
									signal: controller.signal // Attach the fuse to the fetch request
								});

								clearTimeout(fetchTimeout); // Defuse if it succeeds

                                if (!response.ok) throw new Error(`Worker HTTP ${response.status}`);

                                chunkBlob = await response.blob();
                                break; // Fetch succeeded, break out of the retry loop

                            } catch (err) {
                                console.warn(`Chunk ${i} attempt ${attempt} failed:`, err.message);
                                if (attempt === 3) throw err; // If 3rd attempt fails, throw to the outer catch
                                await new Promise(r => setTimeout(r, 2000)); // Wait 2s before retrying
                            }
                        }

                        try {
                            audioQueue[i + 1] = URL.createObjectURL(chunkBlob);
                            await new Promise(r => setTimeout(r, 3000));
                        } catch (fatalErr) {
                            console.error("Chunk completely failed after 3 retries.");
                            window.cpAudioSystemError = true; // Activate kill switch
                            trackCPEvent('ai_audio_error', { error_message: fatalErr.message });

                            if (i === 0 && currentPlayingIndex === 0) {
                                iconSpinner.style.display = 'none';
                                iconPause.style.display = 'none';
                                iconPlay.style.display = 'block';
                                statusText.innerText = t.error;
                                updateOriginalButtons(t.error, true);
                                isAudioSystemActive = false;
                            }
                            break; // Stop fetching further chunks
                        }
                    }

                    if (!window.cpAudioSystemError) {
                        audioQueue[chunks.length + 1] = t.CP_OUTRO_URL;
                    }
                }

                processQueueSequentially();
            });
        });
    }
});
</script>

