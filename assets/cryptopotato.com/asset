	// Function to clear localStorage if 24 hours have passed
	function clearStorageAfter24Hours() {
		const savedTimestamp = localStorage.getItem(TIMESTAMP_KEY);

		// If there is a timestamp saved
		if (savedTimestamp) {
			const currentTime = new Date().getTime();

			// If the saved timestamp is more than 24 hours old, clear storage
			if (currentTime - savedTimestamp > EXPIRY_TIME) {
				localStorage.removeItem(MODE_KEY);
				localStorage.removeItem(TIMESTAMP_KEY);
			}
		}
	}

	// Call the function to check for expiration
	clearStorageAfter24Hours();

