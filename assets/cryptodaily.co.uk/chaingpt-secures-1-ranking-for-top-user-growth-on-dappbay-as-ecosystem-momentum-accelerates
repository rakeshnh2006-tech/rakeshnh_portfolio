                if (!sidebar || !sidebarInner || !articleGrid) return true;

                if (!desktopMedia.matches) {
                    destroy();
                    return true;
                }

                if (!pluginIsReady()) return false;

                const sticky = instance();
                if (sticky) {
                    sticky.options.topSpacing = topSpacing;
                    sticky.options.bottomSpacing = 24;
                    sticky.updateSticky();
