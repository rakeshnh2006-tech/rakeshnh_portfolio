                    const body = toc.querySelector('.cd-article__toc-body');
                    const button = toc.querySelector('.cd-article__toc-toggle');
                    const label = button?.querySelector('span');
                    if (!body || !button || !label) return;

                    toc.dataset.cdaTocReady = 'true';
