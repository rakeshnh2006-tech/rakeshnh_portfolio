        <script>
            (function () {
                function initializeGlossaryBrowser(browser) {
                    if (browser.dataset.glossaryReady === 'true') return;
                    browser.dataset.glossaryReady = 'true';

                    const form = browser.querySelector('[data-glossary-search]');
                    const input = form ? form.querySelector('input[name="q"]') : null;
                    const results = browser.querySelector('[data-glossary-results]');
                    const list = browser.querySelector('[data-glossary-list]');
                    const empty = browser.querySelector('[data-glossary-empty]');
                    const load = browser.querySelector('[data-glossary-load]');
                    const loadButton = load ? load.querySelector('.load-more-btn') : null;
                    const status = browser.querySelector('[data-glossary-status]');
                    const resetItem = browser.querySelector('[data-glossary-reset-item]');
                    const heading = document.querySelector('[data-glossary-heading]');
                    const baseUrl = new URL(browser.dataset.baseUrl, window.location.href);
                    let requestController = null;

                    if (!form || !results || !list || !empty || !load || !loadButton) return;

                    function syncControls(url) {
                        const letter = url.searchParams.get('letter') || '';
                        const query = url.searchParams.get('q') || '';

                        browser.querySelectorAll('[data-glossary-filter]').forEach(function (link) {
                            const linkUrl = new URL(link.href, window.location.href);
                            const isActive = !!letter && linkUrl.searchParams.get('letter') === letter;
                            if (isActive) link.setAttribute('aria-current', 'true');
                            else link.removeAttribute('aria-current');
                        });

                        if (input) input.value = query;
                        if (resetItem) resetItem.hidden = !letter && !query;

                        if (heading) {
                            const baseTitle = heading.dataset.baseTitle || heading.textContent.trim();
                            if (query) heading.textContent = baseTitle + ' - Search for: ' + query;
                            else if (letter) heading.textContent = baseTitle + ' - Search for: letter "' + letter + '"';
                            else heading.textContent = baseTitle;
                        }
                    }

                    async function loadResults(target, pushState) {
                        const url = new URL(target, window.location.href);
                        if (requestController) requestController.abort();
                        requestController = new AbortController();

                        browser.classList.add('is-loading');
                        results.setAttribute('aria-busy', 'true');
                        if (status) status.textContent = 'Loading…';

                        try {
                            const response = await fetch(url.toString(), {
                                headers: {
                                    'Accept': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                signal: requestController.signal
                            });

                            if (!response.ok) throw new Error('Glossary request failed');

                            const data = await response.json();
                            const hasResults = Boolean(data.has_results);
                            list.innerHTML = data.view || '';
                            list.hidden = !hasResults;
                            empty.hidden = hasResults;
                            load.hidden = !hasResults;
                            loadButton.dataset.url = data.link || '';
                            loadButton.disabled = !data.link;

                            syncControls(url);
                            if (pushState) window.history.pushState({ glossaryUrl: url.toString() }, '', url.toString());

                            if (window.lazyLoadInstance && typeof window.lazyLoadInstance.update === 'function') {
                                window.lazyLoadInstance.update();
                            }
                            if (window.cdSharedStickySidebars) window.cdSharedStickySidebars.update(30);
                            if (status) status.textContent = hasResults ? '' : 'No matching terms found.';
                        } catch (error) {
                            if (error.name === 'AbortError') return;
                            window.location.assign(url.toString());
                        } finally {
                            browser.classList.remove('is-loading');
                            results.setAttribute('aria-busy', 'false');
                        }
                    }

                    browser.addEventListener('click', function (event) {
                        const link = event.target.closest('[data-glossary-filter]');
                        if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
                        event.preventDefault();
                        loadResults(link.href, true);
                    });

                    form.addEventListener('submit', function (event) {
                        event.preventDefault();
                        const url = new URL(baseUrl.toString());
                        const query = input ? input.value.trim() : '';
                        if (query) url.searchParams.set('q', query);
                        loadResults(url.toString(), true);
                    });

                    window.addEventListener('popstate', function () {
                        const current = new URL(window.location.href);
                        if (current.pathname === baseUrl.pathname) loadResults(current.toString(), false);
                    });

                    syncControls(new URL(window.location.href));
                }

                function initializeGlossaryBrowsers() {
                    document.querySelectorAll('[data-glossary-browser]').forEach(initializeGlossaryBrowser);
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initializeGlossaryBrowsers, { once: true });
                } else {
                    initializeGlossaryBrowsers();
                }
            })();
        </script>
    </template>

