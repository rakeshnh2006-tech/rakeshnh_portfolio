                function bootSidebars() {
                    initializeLegacySidebars();
                    syncPremiumSidebars();
                    observePremiumSidebars();
                }

                document.addEventListener('cd:sticky-sidebar-ready', function () { schedulePremiumUpdate(0); });
                window.addEventListener('resize', function () { schedulePremiumUpdate(50); }, { passive: true });
                window.addEventListener('load', function () { schedulePremiumUpdate(0); }, { once: true });
                if (typeof desktopMedia.addEventListener === 'function') {
